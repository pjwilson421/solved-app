# Copy to `.env.local` and fill in values (no spaces around `=`).
# Restart the dev server after changes.
# Do not commit real secrets.

# --- Shared password (required) ---
# The app fails closed without both of these. Set them in Vercel before merging.
# STUDIO_PASSWORD is the same name SOLVED Studio uses.
# STUDIO_SESSION_SECRET signs the HttpOnly session cookie (12 hours).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
STUDIO_PASSWORD=
STUDIO_SESSION_SECRET=

# --- Google Gemini (image generation, video generation) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Alternative env names also read by `app/api/ai/generate-image/route.ts`:
# GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_AI_API_KEY=

# Optional override for the image model (default: gemini-2.5-flash-image)
# GEMINI_IMAGE_MODEL=

# --- Anthropic Claude (chat API) ---
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
